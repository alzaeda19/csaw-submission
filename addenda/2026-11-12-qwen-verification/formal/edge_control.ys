read_verilog -formal -sv -DALLOW_DISCLOSED_FAULT_CASE sources/modified_protocol_dut.sv formal/edge_protocol_harness.sv
prep -top edge_protocol_harness -flatten
clk2fflogic
opt_clean
sat -seq 325 -set-assumes -prove-asserts  -show word_a -show word_b -show mode_a -show mode_b -show cycle -show miso -dump_json formal/edge_control/counterexample.json
