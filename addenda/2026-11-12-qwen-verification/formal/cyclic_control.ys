read_verilog -formal -sv -DALLOW_DISCLOSED_FAULT_CASE sources/modified_protocol_dut.sv formal/cyclic_normal_harness.sv
prep -top cyclic_normal_harness -flatten
async2sync
dffunmap
opt_clean
sat -seq 85 -set-assumes -prove-asserts -show phase -show word_in -show mode -show miso -dump_json formal/cyclic_control/counterexample.json
